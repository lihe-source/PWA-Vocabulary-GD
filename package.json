{
  "name": "pwa-vocabulary-gd-v7-5-0",
  "version": "7.5.0",
  "private": true,
  "type": "module",
  "description": "英文單字複習 PWA、免彈窗 Google 續登入與 Drive 同步",
  "scripts": {
    "check": "node check-release.mjs",
    "test": "node --test test-*.mjs",
    "worker:dev": "wrangler dev --test-scheduled",
    "worker:deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute vocabulary-reminders --remote --file=schema.sql",
    "vapid:generate": "web-push generate-vapid-keys --json",
    "auth:dev": "wrangler dev --config wrangler-auth.toml",
    "auth:deploy": "wrangler deploy --config wrangler-auth.toml",
    "auth:db:init": "wrangler d1 execute vocabulary-google-auth --config wrangler-auth.toml --remote --file=cloud-auth-schema.sql"
  },
  "dependencies": {
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=24"
  }
}
